---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import { Button } from '@/components/ui/button';
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';
import { Code2, Cpu, MessageCircle, Github, ArrowRight } from 'lucide-react';
---

<BaseLayout
  title="FOXOps TechGroup"
  description="FOXOps TechGroup — 开源技术团队"
>
  <Navbar />

  <main class="min-h-screen">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-background to-accent/10" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent" />
      <div class="container mx-auto px-4 py-32 sm:py-40 relative">
        <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
          <img
            src="/logo/foxnobg.png"
            alt="FOXOps"
            class="w-20 h-20 sm:w-28 sm:h-28 object-contain mb-8 animate-bounce-slow"
          />
          <Badge variant="secondary" class="mb-6 px-4 py-1.5 text-sm">FOXOps TechGroup</Badge>
          <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-foreground mb-6 leading-tight">
            用开源工具<span class="text-primary">解决问题</span>
          </h1>
          <p class="text-lg sm:text-xl text-muted-foreground max-w-xl mb-10 leading-relaxed">
            一群热爱技术的开发者，用工程思维构建开源产品。
          </p>
          <div class="flex gap-4 flex-wrap justify-center">
            <a href="https://github.com/FOXOps-TechGroup">
              <Button size="lg" class="gap-2">
                <Github class="h-5 w-5" />
                GitHub
                <ArrowRight class="h-4 w-4" />
              </Button>
            </a>
            <a href="#projects">
              <Button variant="outline" size="lg">
                查看项目
              </Button>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="container mx-auto px-4 py-24">
      <div class="max-w-3xl mx-auto text-center">
        <Badge variant="outline" class="mb-4">关于我们</Badge>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-6">
          不止写代码
        </h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          FOXOps TechGroup 是一个由学生组成的开源技术团队。
          我们关注嵌入式系统、无人机控制、开发者工具和开源社区建设。
          每个项目都源于真实需求，每个方案都经过工程验证。
        </p>
      </div>
    </section>

    <Separator />

    <!-- Projects -->
    <section id="projects" class="container mx-auto px-4 py-24">
      <div class="text-center mb-16">
        <Badge variant="outline" class="mb-4">项目方向</Badge>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
          我们在做什么
        </h2>
        <p class="text-muted-foreground max-w-xl mx-auto">
          三个方向，一个目标：让技术更可用。
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
        <Card class="group hover:shadow-md transition-shadow">
          <CardHeader>
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
              <Code2 class="h-6 w-6 text-primary" />
            </div>
            <CardTitle>开源工具</CardTitle>
            <CardDescription>
              开发和维护面向开发者的实用开源工具与库，降低技术门槛。
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div class="flex flex-wrap gap-2">
              <Badge variant="secondary">Python</Badge>
              <Badge variant="secondary">TypeScript</Badge>
              <Badge variant="secondary">CLI</Badge>
            </div>
          </CardContent>
        </Card>

        <Card class="group hover:shadow-md transition-shadow">
          <CardHeader>
            <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center mb-4">
              <Cpu class="h-6 w-6 text-accent-foreground" />
            </div>
            <CardTitle>嵌入式系统</CardTitle>
            <CardDescription>
              探索无人机、嵌入式设备与上位机软件的交互方案。
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div class="flex flex-wrap gap-2">
              <Badge variant="secondary">C++</Badge>
              <Badge variant="secondary">Drone</Badge>
              <Badge variant="secondary">QT</Badge>
            </div>
          </CardContent>
        </Card>

        <Card class="group hover:shadow-md transition-shadow">
          <CardHeader>
            <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center mb-4">
              <MessageCircle class="h-6 w-6 text-accent-foreground" />
            </div>
            <CardTitle>技术分享</CardTitle>
            <CardDescription>
              通过博客与演示分享项目经验，推动技术社区进步。
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div class="flex flex-wrap gap-2">
              <Badge variant="secondary">Blog</Badge>
              <Badge variant="secondary">Presentation</Badge>
              <Badge variant="secondary">Docs</Badge>
            </div>
          </CardContent>
        </Card>
      </div>
    </section>

    <Separator />

    <!-- CTA -->
    <section class="container mx-auto px-4 py-24">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold tracking-tight mb-4">
          加入我们
        </h2>
        <p class="text-muted-foreground text-lg mb-8">
          如果你也对开源有热情，欢迎来 GitHub 找到我们。
        </p>
        <a href="https://github.com/FOXOps-TechGroup">
          <Button size="lg" class="gap-2">
            <Github class="h-5 w-5" />
            访问 GitHub 组织
          </Button>
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t">
      <div class="container mx-auto px-4 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <img src="/logo/origin-min.png" alt="FOXOps" class="h-8 w-8 object-contain rounded" />
          <span class="text-sm font-semibold">FOXOps TechGroup</span>
        </div>
        <div class="flex items-center gap-6 text-sm text-muted-foreground">
          <a href="https://github.com/FOXOps-TechGroup" class="hover:text-foreground transition-colors">GitHub</a>
        </div>
        <p class="text-xs text-muted-foreground">
          Built with Astro &amp; ShadCN/UI &middot; Powered by GitHub Pages
        </p>
      </div>
    </footer>
  </main>
</BaseLayout>
