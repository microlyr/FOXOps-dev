---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import { Button } from '@/components/ui/button';
import { Card, CardHeader, CardTitle, CardDescription } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';
import { Trophy, Users, Mail, Monitor, Cpu, Terminal, ChevronRight } from 'lucide-react';
---

<BaseLayout
  title="JXCPC Tech Group"
  description="JXCPC Tech Group — Technical operations for XCPC programming contests in Jiangxi Province"
>
  <Navbar />

  <main class="min-h-screen">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-background to-accent/10" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-transparent to-transparent" />
      <!-- 装饰圆点 -->
      <div class="absolute top-20 left-10 w-64 h-64 bg-primary/5 rounded-full blur-3xl" />
      <div class="absolute bottom-10 right-10 w-48 h-48 bg-accent/10 rounded-full blur-3xl" />
      <div class="container mx-auto px-4 py-32 sm:py-40 relative">
        <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
          <!-- 狐狸吉祥物 -->
          <img
            src="/logo/foxnobg.png"
            alt="Mascot"
            class="w-24 h-24 sm:w-32 sm:h-32 object-contain mb-6 animate-bounce-slow"
          />
          <Badge variant="secondary" class="mb-6 px-4 py-1.5 text-sm">JXCPC Tech Group</Badge>
          <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-foreground mb-6 leading-tight">
            为编程竞赛<span class="text-primary">保驾护航</span>
          </h1>
          <p class="text-lg sm:text-xl text-muted-foreground max-w-xl mb-10 leading-relaxed">
            We provide technical operation and maintenance for XCPC contests in and outside Jiangxi Province.
          </p>
          <div class="flex gap-4 flex-wrap justify-center">
            <a href="#contests">
              <Button size="lg" class="gap-2">
                <Trophy class="h-5 w-5" />
                服务过的赛事
                <ChevronRight class="h-4 w-4" />
              </Button>
            </a>
            <a href="#join">
              <Button variant="outline" size="lg" class="gap-2">
                <Users class="h-5 w-5" />
                加入我们
              </Button>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="container mx-auto px-4 py-24">
      <div class="max-w-3xl mx-auto text-center">
        <Badge variant="outline" class="mb-4">About</Badge>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-6">
          JXCPC Tech Group
        </h2>
        <p class="text-muted-foreground text-lg leading-relaxed max-w-2xl mx-auto">
          We are dedicated to the technical operation and maintenance of XCPC contests in and outside Jiangxi Province.
          Our organization is still in the early stage. If you want to contribute, welcome to join us.
        </p>
        <div class="flex justify-center gap-10 mt-10 text-center">
          <div>
            <div class="text-3xl font-bold text-primary">3+</div>
            <div class="text-sm text-muted-foreground mt-1">Contests Served</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-primary">2023</div>
            <div class="text-sm text-muted-foreground mt-1">Since</div>
          </div>
        </div>
      </div>
    </section>

    <Separator />

    <!-- Capabilities -->
    <section class="container mx-auto px-4 py-24">
      <div class="text-center mb-16">
        <Badge variant="outline" class="mb-4">Capabilities</Badge>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
          技术能力
        </h2>
      </div>

      <div class="grid gap-8 sm:grid-cols-3 max-w-4xl mx-auto">
        <div class="text-center">
          <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mx-auto mb-4">
            <Monitor class="h-7 w-7 text-primary" />
          </div>
          <h3 class="font-semibold mb-2">竞赛系统运维</h3>
          <p class="text-sm text-muted-foreground">DOMjudge / Hydro 等判题系统的部署、配置与现场运维</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-xl bg-accent/10 flex items-center justify-center mx-auto mb-4">
            <Terminal class="h-7 w-7 text-accent-foreground" />
          </div>
          <h3 class="font-semibold mb-2">工具链开发</h3>
          <p class="text-sm text-muted-foreground">比赛环境自动化、LiveCD 制作、选手端工具</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-xl bg-accent/10 flex items-center justify-center mx-auto mb-4">
            <Cpu class="h-7 w-7 text-accent-foreground" />
          </div>
          <h3 class="font-semibold mb-2">嵌入式 & 无人机</h3>
          <p class="text-sm text-muted-foreground">嵌入式开发、无人机上位机交互</p>
        </div>
      </div>
    </section>

    <Separator />

    <!-- Contests Served -->
    <section id="contests" class="container mx-auto px-4 py-24">
      <div class="text-center mb-16">
        <Badge variant="outline" class="mb-4">Contests</Badge>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">
          We Have Served
        </h2>
        <p class="text-muted-foreground max-w-xl mx-auto">
          Providing technical support for XCPC programming contests.
        </p>
      </div>

      <div class="grid gap-6 max-w-3xl mx-auto">
        <Card>
          <CardHeader>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <Trophy class="h-5 w-5 text-primary" />
              </div>
              <div>
                <CardTitle class="text-lg">2025 ICPC National Invitational (Nanchang)</CardTitle>
                <CardDescription>&amp; 2025 ICPC Jiangxi Provincial Programming Contest</CardDescription>
              </div>
            </div>
          </CardHeader>
        </Card>

        <Card>
          <CardHeader>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <Trophy class="h-5 w-5 text-primary" />
              </div>
              <div>
                <CardTitle class="text-lg">2024 ICPC Jiangxi Provincial Programming Contest</CardTitle>
              </div>
            </div>
          </CardHeader>
        </Card>

        <Card>
          <CardHeader>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
                <Trophy class="h-5 w-5 text-primary" />
              </div>
              <div>
                <CardTitle class="text-lg">2023 ICPC Jiangxi Provincial Programming Contest</CardTitle>
              </div>
            </div>
          </CardHeader>
        </Card>
      </div>
    </section>

    <Separator />

    <!-- Join Us -->
    <section id="join" class="container mx-auto px-4 py-24">
      <div class="max-w-2xl mx-auto text-center">
        <Badge variant="outline" class="mb-4">Join Us</Badge>
        <h2 class="text-3xl font-bold tracking-tight mb-4">加入我们</h2>
        <p class="text-muted-foreground text-lg mb-6">
          We are currently on an invitation-only basis.
        </p>
        <Card class="inline-block text-left mx-auto">
          <CardHeader>
            <div class="flex items-center gap-3 mb-2">
              <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center">
                <Mail class="h-4 w-4 text-primary" />
              </div>
              <span class="text-sm text-muted-foreground">Send your CV to</span>
            </div>
            <a href="mailto:weiqi_yan@outlook.com" class="text-lg font-mono font-semibold text-primary hover:underline pl-12">
              weiqi_yan@outlook.com
            </a>
          </CardHeader>
        </Card>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t">
      <div class="container mx-auto px-4 py-10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <img src="/logo/origin-min.png" alt="Logo" class="h-8 w-8 object-contain rounded" />
          <span class="text-sm font-semibold">JXCPC Tech Group</span>
        </div>
        <div class="flex items-center gap-6 text-sm text-muted-foreground">
          <a href="/about" class="hover:text-foreground transition-colors">About</a>
          <a href="/notes" class="hover:text-foreground transition-colors">Notes</a>
          <a href="mailto:weiqi_yan@outlook.com" class="hover:text-foreground transition-colors">Contact</a>
        </div>
        <p class="text-xs text-muted-foreground">
          Built with Astro &amp; ShadCN/UI
        </p>
      </div>
    </footer>
  </main>
</BaseLayout>
