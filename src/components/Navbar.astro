---
import ThemeToggle from '@/components/ThemeToggle';
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href="/" class="flex items-center gap-2 font-bold text-lg">
      <img src="/logo/tag.png" alt="FOXOps" class="h-8 w-8 object-contain" />
      <span class="hidden sm:inline">FOXOps</span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-muted-foreground">
      <a href="#about" class="hover:text-foreground transition-colors">关于</a>
      <a href="#projects" class="hover:text-foreground transition-colors">项目</a>
      <a href="https://github.com/FOXOps-TechGroup" class="hover:text-foreground transition-colors">GitHub</a>
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle client:load />
    </div>
  </div>
</header>
